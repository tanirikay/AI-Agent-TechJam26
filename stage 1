from __future__ import annotations

import json
import re
import sqlite3
from pathlib import Path


TOKEN_RE = re.compile(r"[a-z0-9]+", re.IGNORECASE)
STOPWORDS = {
    "a", "an", "and", "are", "as", "at", "be", "but", "by", "for", "from",
    "i", "in", "is", "it", "me", "my", "of", "on", "or", "please", "some",
    "that", "the", "this", "to", "want", "with", "would", "you", "looking",
}

# Domain attributes for slot extraction and active clarification
KNOWN_ATTRIBUTES = ["category", "color", "size", "brand", "material", "gender"]

COLOR_MAP = {"black", "white", "red", "blue", "green", "yellow", "brown", "grey", "gray", "pink", "purple"}
CATEGORY_MAP = {"shoes", "sneakers", "boots", "jacket", "shirt", "pants", "dress", "hoodie", "watch", "bag"}


def _text(value: object) -> str:
    if value is None:
        return ""
    if isinstance(value, dict):
        return " ".join(f"{key} {item}" for key, item in value.items())
    if isinstance(value, list):
        return " ".join(str(item) for item in value)
    return str(value)


def _terms(text: str) -> list[str]:
    return [
        token.lower()
        for token in TOKEN_RE.findall(text)
        if len(token) > 1 and token.lower() not in STOPWORDS
    ]


class Agent:
    def __init__(self, catalog_path: str | Path = "data/catalog.jsonl") -> None:
        self.catalog_path = Path(catalog_path)
        self.connection = sqlite3.connect(":memory:")
        self._sessions: set[str] = set()
        
        # Schema-compliant state: dictionary-based slot tracking per session
        self._user_profiles: dict[str, dict] = {}
        self._session_slots: dict[str, dict[str, str]] = {}
        self._asked_attributes: dict[str, set[str]] = {}

        self._build_index()

    def _build_index(self) -> None:
        cursor = self.connection.cursor()
        cursor.execute(
            "CREATE VIRTUAL TABLE products USING fts5("
            "parent_asin UNINDEXED, title, categories, features, details, store, description, "
            "tokenize='unicode61 remove_diacritics 2')"
        )
        batch: list[tuple[str, str, str, str, str, str, str]] = []
        with self.catalog_path.open(encoding="utf-8") as handle:
            for line in handle:
                product = json.loads(line)
                batch.append(
                    (
                        str(product["parent_asin"]),
                        _text(product.get("title")),
                        _text(product.get("categories")),
                        _text(product.get("features")),
                        _text(product.get("details")),
                        _text(product.get("store")),
                        _text(product.get("description")),
                    )
                )
                if len(batch) >= 1000:
                    cursor.executemany("INSERT INTO products VALUES (?, ?, ?, ?, ?, ?, ?)", batch)
                    batch.clear()
        if batch:
            cursor.executemany("INSERT INTO products VALUES (?, ?, ?, ?, ?, ?, ?)", batch)
        self.connection.commit()

    def reset(self, session_id: str, user_profile: dict) -> None:
        self._sessions.add(session_id)
        # Strict adherence to docs/agent_api_contract.json (only standard user profile fields)
        self._user_profiles[session_id] = user_profile or {}
        self._session_slots[session_id] = {}
        self._asked_attributes[session_id] = set()

    def _extract_and_update_slots(self, session_id: str, message: str) -> None:
        """Slot-filling extraction with per-slot override handling (no full wipes)."""
        tokens = set(_terms(message))
        slots = self._session_slots[session_id]

        # Extract Category (Overwrites prior category slot if a new category is specified)
        matched_categories = tokens.intersection(CATEGORY_MAP)
        if matched_categories:
            slots["category"] = list(matched_categories)[0]

        # Extract Color (Overwrites prior color slot if a new color is specified)
        matched_colors = tokens.intersection(COLOR_MAP)
        if matched_colors:
            slots["color"] = list(matched_colors)[0]

        # Extract Generic Keywords (Store non-slot tokens safely without overwriting structured slots)
        generic_tokens = tokens - CATEGORY_MAP - COLOR_MAP
        if generic_tokens:
            existing_keywords = set(slots.get("keywords", "").split())
            # Update keyword set
            slots["keywords"] = " ".join(existing_keywords.union(generic_tokens))

    def _determine_next_attribute_to_ask(self, session_id: str) -> str | None:
        """Determines missing high-priority attributes to actively prompt the user."""
        slots = self._session_slots[session_id]
        asked = self._asked_attributes[session_id]
        profile = self._user_profiles.get(session_id, {})
        preference_tags = profile.get("preference_tags", [])

        # Attribute priority order: profile preferences first, then standard slot hierarchy
        priority_order = [tag for tag in preference_tags if tag in KNOWN_ATTRIBUTES]
        for attr in KNOWN_ATTRIBUTES:
            if attr not in priority_order:
                priority_order.append(attr)

        for attr in priority_order:
            if attr not in slots and attr not in asked:
                asked.add(attr)
                return attr
        return None

    def respond(
        self,
        session_id: str,
        user_message: str,
        turn: int,
        top_k: int,
    ) -> dict:
        if session_id not in self._sessions:
            raise RuntimeError("reset must be called before respond")

        # 1. Update slots with per-slot overwrite handling
        self._extract_and_update_slots(session_id, user_message)
        slots = self._session_slots[session_id]

        # 2. Construct search query strictly from ACTIVE slots (prevents term pollution)
        query_parts = []
        if "category" in slots:
            query_parts.append(f'"{slots["category"]}"')
        if "color" in slots:
            query_parts.append(f'"{slots["color"]}"')
        if "keywords" in slots and slots["keywords"]:
            query_parts.append(" OR ".join(f'"{kw}"' for kw in slots["keywords"].split()[:5]))

        expression = " AND ".join(query_parts) if query_parts else ""

        # 3. Candidate Retrieval via SQLite FTS5 BM25
        recommendations: list[dict] = []
        if expression:
            try:
                # Rank heavily on Title and Category fields
                query = """
                    SELECT parent_asin FROM products WHERE products MATCH ? 
                    ORDER BY bm25(products, 0.0, 10.0, 5.0, 2.0, 1.0, 1.0, 1.0) 
                    LIMIT ?
                """
                rows = self.connection.execute(query, (expression, top_k)).fetchall()
                recommendations = [{"parent_asin": str(row[0])} for row in rows]
            except sqlite3.OperationalError:
                pass

        # 4. Active Clarification Disclosure Check (ask_attribute)
        # Ask for missing attributes in earlier turns to unlock customer responses
        ask_attribute = None
        if turn < 3 and len(recommendations) < top_k:
            ask_attribute = self._determine_next_attribute_to_ask(session_id)

        return {
            "message": f"Asking about {ask_attribute}" if ask_attribute else "Here are your matching products.",
            "ask_attribute": ask_attribute,
            "recommendations": recommendations,
            "usage": {"prompt_tokens": 0, "completion_tokens": 0},
        }
